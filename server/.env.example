# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/pos_system

# ─── Authentication ─────────────────────────────────────────────────────────
# Both secrets must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-32-chars-min
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Platform administration ────────────────────────────────────────────────
# Guards POST /api/platform/tenants, which onboards a new company.
# Server side only: never ship this to a browser or desktop build.
PLATFORM_API_KEY=replace-me-with-a-long-random-string

# ─── Licensing ──────────────────────────────────────────────────────────────
# Generate both with `npm run license:keys`. The signing key stays on the
# server; the public key also goes into electron/app.config.json.
LICENSE_SIGNING_KEY=
LICENSE_PUBLIC_KEY=
# Free days a self-registered company gets. 0 = locked until you issue a key.
LICENSE_TRIAL_DAYS=14
# Set to false to hide the public sign up and onboard customers by hand only.
PUBLIC_SIGNUP_ENABLED=true

# ─── Browser clients ────────────────────────────────────────────────────────
# Comma separated. Leave empty in development to allow any origin.
CORS_ORIGINS=https://pos.example.com

# ─── Google Drive image backup (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
